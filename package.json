{
  "name": "petagenda",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do PetAgenda desenvolvido de forma incremental para o MVP da disciplina.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",

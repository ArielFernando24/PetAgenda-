PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Docker Compose publica o PostgreSQL na porta 5433.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/petagenda?schema=public"
# Gere uma chave: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
MAIL_PROVIDER="console"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tutor {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  senha_hash   String   @db.VarChar(255)
  data_criacao DateTime @default(now()) @map("data_criacao")
  pets         Pet[]

  @@map("tutor")
}

enum PetSex {
  MACHO
  FEMEA
  NAO_INFORMADO
}

model Pet {
  id             String   @id @default(uuid()) @db.Uuid
  tutorId        String   @map("tutor_id") @db.Uuid
  nome           String   @db.VarChar(80)
  especie        String   @db.VarChar(50)
  raca           String?  @db.VarChar(80)
  sexo           PetSex   @default(NAO_INFORMADO)
  dataNascimento DateTime @map("data_nascimento") @db.Date
  createdAt      DateTime @default(now()) @map("data_criacao")
  updatedAt      DateTime @updatedAt @map("data_atualizacao")
  tutor          Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  eventos        Evento[]

  @@index([tutorId])
  @@map("pet")
}

enum TipoCuidado {
  VACINA
  VERMIFUGO
  BANHO_E_TOSA
  CONSULTA
  REMEDIO
}

enum Recorrencia {
  NENHUMA
  SEMANAL
  MENSAL
  ANUAL
  PERSONALIZADA
}

enum StatusEvento {
  PENDENTE
  CONCLUIDO
  CANCELADO
}

model Evento {
  id          String        @id @default(uuid()) @db.Uuid
  petId       String        @map("pet_id") @db.Uuid
  tipoCuidado TipoCuidado   @map("tipo_cuidado")
  dataHora    DateTime      @map("data_hora")
  recorrencia Recorrencia   @default(NENHUMA) @map("recorrencia")
  status      StatusEvento  @default(PENDENTE) @map("status")
  descricao   String?       @db.VarChar(255) @map("descricao")
  createdAt   DateTime      @default(now()) @map("data_criacao")
  updatedAt   DateTime      @updatedAt @map("data_atualizacao")

  pet         Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([dataHora])
  @@map("evento")
}

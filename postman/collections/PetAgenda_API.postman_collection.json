          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "US01 - Autenticação e Tutor",
      "item": [
        {
          "name": "1. Cadastrar Tutor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mariana Silva\",\n  \"email\": \"mariana@exemplo.com\",\n  \"senha\": \"senhaSegura123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tutores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tutores"]
            }
          }
        },
        {
          "name": "2. Login Tutor (Salva Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Token JWT salvo com sucesso!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mariana@exemplo.com\",\n  \"senha\": \"senhaSegura123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "3. Obter Perfil do Tutor (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tutores/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tutores", "me"]
            }
          }
        }
      ]
    },
